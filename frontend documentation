4. Example API Service

// services/api.ts
const API_BASE = 'http://localhost:8000';

export const api = {
  // Create new lead
  createLead: async (leadData: Partial<Lead>) => {
    const response = await fetch(`${API_BASE}/leads`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(leadData)
    });
    return response.json();
  },

  // Make call to lead
  callLead: async (leadId: string) => {
    const response = await fetch(`${API_BASE}/leads/${leadId}/call`, {
      method: 'POST'
    });
    return response.json();
  },

  // Process emails
  processEmails: async () => {
    const response = await fetch(`${API_BASE}/leads/process-emails`, {
      method: 'POST'
    });
    return response.json();
  }
};

5. Example Component

// components/LeadsList.tsx
import { useEffect, useState } from 'react';
import { supabase } from '../services/supabase';

export const LeadsList = () => {
  const [leads, setLeads] = useState<Lead[]>([]);

  useEffect(() => {
    const fetchLeads = async () => {
      const { data, error } = await supabase
        .from('leads')
        .select('*')
        .order('created_at', { ascending: false });
      
      if (data) setLeads(data);
    };

    fetchLeads();
  }, []);

  return (
    <div>
      {leads.map(lead => (
        <div key={lead.id}>
          <h3>{lead.first_name} {lead.last_name}</h3>
          <p>{lead.email}</p>
          <button onClick={() => api.callLead(lead.id)}>
            Make Call
          </button>
        </div>
      ))}
    </div>
  );
};