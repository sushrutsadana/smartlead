1. API Endpoints Documentation

// Base URL: http://localhost:8000

// Types
interface Lead {
  id: string;
  first_name: string;
  last_name: string;
  email: string;
  phone_number?: string;
  company_name?: string;
  title?: string;
  lead_source: string;
  status: string;
  created_at: string;
}

interface Activity {
  id: string;
  lead_id: string;
  activity_type: 'EMAIL_SENT' | 'CALL_MADE' | 'LEAD_CREATED';
  body: string;
  activity_datetime: string;
}

// API Endpoints

// 1. Create Lead
POST /leads
Body: {
  first_name: string;
  last_name: string;
  email: string;
  phone_number?: string;
  company_name?: string;
  title?: string;
  lead_source?: string;
  status?: string;
}
Response: {
  status: "success";
  data: Lead;
}

// 2. Log Activity
POST /leads/{lead_id}/activities
Body: {
  activity_type: 'EMAIL_SENT' | 'CALL_MADE' | 'LEAD_CREATED';
  body: string;
  activity_datetime: string;
}
Response: {
  status: "success";
  data: Activity;
}

// 3. Process Emails
POST /leads/process-emails
Response: {
  status: "success";
  message: string;
}

// 4. Make Call
POST /leads/{lead_id}/call
Response: {
  status: "success";
  data: {
    call_id: string;
    status: string;
    // ... other call details
  }
}

